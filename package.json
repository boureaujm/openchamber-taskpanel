{
  "name": "@boureaujm/openchamber-taskpanel",
  "version": "1.1.0",
  "private": false,
  "description": "OpenChamber extension that displays Markdown task plans with a visual progress bar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/boureaujm/openchamber-taskpanel.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "test": "bun test"
  },
  "dependencies": {
    "@openchamber/sdk": "^1.24.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "task-panel",
        "name": "Task Panel",
        "icon": "task-line",
        "entry": "panel/index.html"
      },
      "capabilities": ["files"]
    }
  }
}
